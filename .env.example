# Copy this file to .env and fill in your IAM credentials
# Never commit .env to version control!

AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your_secret_here
AWS_DEFAULT_REGION=us-east-1

# Auth0
AUTH0_DOMAIN=dev-xxx.us.auth0.com
AUTH0_AUDIENCE=https://api.acme.test
AUTH0_CLIENT_ID=<update-your-client-id>
AUTH0_CLIENT_SECRET=<update-your-client-secret>
AUTH0_REALM=Username-Password-Authentication